# ─────────────────────────────────────────────────────────────────────────────
# Automated Multi-Platform Posting System — Environment Variables Template
# Copy this file to .env and fill in your credentials.
#
#   cp .env.example .env     (macOS/Linux)
#   copy .env.example .env   (Windows)
#
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────────────────────
# Create a bot via @BotFather and get the token.
# Add the bot to a channel/group as admin and get the chat ID.
# Chat ID of a public channel: @channelname  |  private group: -1001234567890
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Bluesky (AT Protocol) ─────────────────────────────────────────────────────
# Your Bluesky handle (e.g. yourname.bsky.social) or DID.
# App password created at: https://bsky.app/settings/app-passwords
# Use an APP PASSWORD, not your main account password.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# ── Mastodon ──────────────────────────────────────────────────────────────────
# Your instance base URL, e.g. https://mastodon.social
# Access token from: Preferences → Development → New Application
# Required scope: write:statuses
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=

# ── LinkedIn ──────────────────────────────────────────────────────────────────
# OAuth 2.0 access token with w_member_social and r_liteprofile scopes.
# Person URN in format: urn:li:person:XXXXXXXX
# Obtain via: https://www.linkedin.com/developers/apps
# Note: Tokens expire after 60 days.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# ── Reddit ────────────────────────────────────────────────────────────────────
# App credentials from: https://www.reddit.com/prefs/apps  (choose "script" type)
# User agent format: <platform>:<app-id>:<version> (by /u/<reddit-username>)
# Subreddit: without the r/ prefix, e.g.  test  or  u_yourusername
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=python:automated-posting:v1.0.0 (by /u/yourusername)
REDDIT_SUBREDDIT=test
